#779 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) 
GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#783)) GLOBAL_UNIT_ASSIGNED_CONTEXT
((#780,#781,#782)) REPRESENTATION_CONTEXT('Context #1',
  '3D Context with UNIT and UNCERTAINTY') );
#780 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#781 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#782 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#783 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#780,
  'distance_accuracy_value','confusion accuracy');
#784 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
#785 = SHAPE_DEFINITION_REPRESENTATION(#786,#792);
#786 = PRODUCT_DEFINITION_SHAPE('','',#787);
#787 = PRODUCT_DEFINITION('design','',#788,#791);
#788 = PRODUCT_DEFINITION_FORMATION('','',#789);
#789 = PRODUCT('base_pad','base_pad','',(#790));
#790 = PRODUCT_CONTEXT('',#2,'mechanical');
#791 = PRODUCT_DEFINITION_CONTEXT('part definition',#2,'design');
#792 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#11,#793),#946);
#793 = MANIFOLD_SOLID_BREP('',#794);
